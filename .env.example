# URL base de la API de Agabo Backend.
# En desarrollo se recomienda dejarlo en /api y usar el proxy de Vite
# (ver vite.config.ts), así se evitan problemas de CORS.
VITE_API_URL=/api

# Client ID de Google OAuth (tipo Web application).
# Es el MISMO valor que GOOGLE_CLIENT_ID del .env del backend.
VITE_GOOGLE_CLIENT_ID=tu-client-id-de-google-aqui
